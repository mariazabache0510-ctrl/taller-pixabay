# Obligatorias. Sin ellas el proceso no arranca. No pongas valores reales en este archivo.
PIXABAY_API_KEY=
MONGODB_URI=
SESSION_SECRET=

# Opcional. Copia de cada búsqueda y cada imagen guardada.
# En Render tiene que ser otra URI de Atlas: el servicio no llega al Mongo de tu máquina.
MONGODB_URI_MIRROR=

# Opcional. Origen permitido además del host de la propia petición, por ejemplo https://taller-pixabay.onrender.com
APP_ORIGIN=

PORT=3000
