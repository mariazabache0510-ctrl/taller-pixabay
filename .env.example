# Mongo principal. En Render usa una URI de Atlas.
# En local puede ser mongodb://127.0.0.1:27017/taller_pixabay
MONGODB_URI=

# Opcional. Recibe una copia de cada búsqueda y cada imagen guardada.
# En tu computador puede ser Atlas mientras la principal es local, o al revés.
# En Render las dos tienen que ser de Atlas: el servicio no llega al Mongo de tu máquina.
MONGODB_URI_MIRROR=

# Clave de https://pixabay.com/api/docs/ — solo en el servidor, nunca en el navegador.
PIXABAY_API_KEY=

PORT=3000
