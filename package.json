{
  "name": "taller-pixabay",
  "version": "1.0.0",
  "private": true,
  "description": "Galería Pixabay con filtro antisesgo — Node.js, Express y MongoDB",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build-cliente.js",
    "prestart": "node scripts/build-cliente.js",
